{
  "dependencies": {
    "@nestjs/mapped-types": "*",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "name": "online-merkato",
  "version": "1.0.0",
  "description": "Online Merkato - E-commerce Platform",
  "private": true,
  "scripts": {
    "backend:dev": "dotenv -e .env -- npm run start:dev --prefix backend",
    "frontend:dev": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:build": "npm run build --prefix backend",
    "frontend:build": "npm run build --prefix frontend",
    "build": "npm run backend:build && npm run frontend:build",
    "backend:install": "npm install --prefix backend",
    "frontend:install": "npm install --prefix frontend",
    "install:all": "npm run backend:install && npm run frontend:install"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@prisma/config": "^7.8.0",
    "concurrently": "^8.2.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0"
  }
}
